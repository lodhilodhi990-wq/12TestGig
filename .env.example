# .env.example
# DO NOT COMMIT REAL SECRETS TO GIT

# ==========================================
# Application Environment
# ==========================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.12testgig.com

# ==========================================
# Firebase / Database Config
# ==========================================
# Service Account JSON (Base64 encoded to prevent formatting issues)
FIREBASE_SERVICE_ACCOUNT_BASE64=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================
# Payments (Stripe / Mock)
# ==========================================
# Set to 'stripe' in production
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ==========================================
# AI Assistant
# ==========================================
# Options: 'mock', 'openai', 'gemini'
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==========================================
# Security & Auth
# ==========================================
# Used for encrypting session cookies or JWTs if applicable
SESSION_SECRET=

# ==========================================
# Storage & CDN
# ==========================================
# If external CDN used for AAB/APK artifacts
CDN_UPLOAD_KEY=
