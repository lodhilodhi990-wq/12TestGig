# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
packages/*/node_modules
apps/*/node_modules

# testing
/coverage

# next.js
/.next/
/out/
apps/web/.next
apps/web/out

# production
/build
dist/
packages/*/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT ignore .env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Security / Secrets
firebase-adminsdk*.json
*.keystore
*.jks
secret-*.json
*-credentials.json

# Android
apps/mobile/build/
apps/mobile/.gradle/
apps/mobile/local.properties
