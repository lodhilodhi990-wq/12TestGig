rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getRole() { return getUserData().role; }
    
    function isAdmin() {
      let role = getRole();
      return role == 'admin' || role == 'super_admin';
    }

    function isOrgMember(orgId) {
      return getUserData().organizationId == orgId || isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (request.resource.data.role in ['customer', 'tester', 'earner']);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) 
        || isAdmin()
      );
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if isAdmin();
    }
    
    match /organization_members/{memberId} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow write: if false; 
    }

    match /projects/{projectId} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow write: if false; 
    }

    match /apps/{appId} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow write: if false; 
    }

    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    match /campaign_days/{dayId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /campaign_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /tester_applications/{appId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOrgMember(resource.data.organizationId));
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; 
    }
    
    match /tester_assignments/{assignId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOrgMember(resource.data.organizationId));
      allow write: if false; 
    }
    
    match /test_sessions/{sessionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOrgMember(resource.data.organizationId));
      allow write: if false;
    }
    
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.organizationId == getUserData().organizationId);
      allow write: if false; 
    }
    
    // PHASE 4
    match /bugs/{bugId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOrgMember(resource.data.organizationId));
      allow write: if false; 
    }
    match /bug_comments/{commentId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isOrgMember(resource.data.organizationId));
      allow write: if false; 
    }
    match /bug_history/{historyId} {
      allow read: if isAuthenticated(); 
      allow write: if false;
    }
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.testerId || isOrgMember(resource.data.organizationId));
      allow write: if false;
    }
    match /tester_reviews/{reviewId} {
      allow read: if isAuthenticated(); 
      allow write: if false;
    }
    match /customer_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /tester_quality_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /tester_badges/{tbId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // PHASE 5: Financial Security
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Strict server-side mutation only
    }
    match /wallet_ledger/{ledgerId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Immutable, server-side only
    }
    match /rewards/{rewardId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOrgMember(resource.data.organizationId) || isAdmin());
      allow write: if false; 
    }
    match /withdrawal_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      // Create allowed strictly if they only supply required fields. Real apps would do this via callable function.
      allow create: if false; // Re-routing all financial interactions through Server Actions for safety
      allow update, delete: if false;
    }
    match /reward_config_versions/{versionId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow write: if false;
    }

    // PHASE 6: Payment, KYC, and Webhooks
    match /payment_methods/{methodId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Managed by Server Actions
    }
    match /identity_verifications/{kycId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Managed by Server Actions
    }
    match /payment_webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Backend only
    }
    match /payment_provider_configs/{configId} {
      allow read: if isAdmin();
      allow write: if false; // Backend/Admin only
    }

    // PHASE 7: Admin Control Center & Risk
    match /user_restrictions/{restrictionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Backend/Admin actions only
    }
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.openedBy || isAdmin());
      allow write: if false; // Managed by Server Actions
    }
    match /risk_events/{eventId} {
      allow read, write: if false; // Backend and Authorized Admins only
    }
    match /admin_notes/{noteId} {
      allow read, write: if false; // Backend and Authorized Admins only
    }
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Managed by Server Actions
    }
    match /application_errors/{errorId} {
      allow read, write: if false; // Backend and Authorized Admins only
    }
    
    // PHASE 8: Analytics & Reports
    match /report_jobs/{jobId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Only server can generate reports
    }

    // PHASE 9: AI & Play Store Readiness
    match /ai_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if false; // Only AI Service (Backend) can write
    }
    match /ai_usage/{usageId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Handled by Backend
    }
    match /play_store_checklists/{appId} {
      allow read: if isAuthenticated(); // App owners check handled by UI/Service layer
      allow write: if false; // Handled by Server Actions
    }
    match /release_checklists/{releaseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Handled by Server Actions
    }

    // PHASE 11: Operations & Incidents
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Handled by backend action
    }
    match /incident_events/{eventId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Handled by backend action
    }
    match /feature_flags/{flagId} {
      allow read: if true; // Publicly readable for Maintenance Mode UI checks
      allow write: if false; // Handled by backend action
    }
    match /releases/{releaseId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Handled by backend action
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
