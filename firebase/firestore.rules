rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getRole() { return getUserData().role; }
    
    function isAdmin() {
      return isAuthenticated();
    }

    function isOrgMember(orgId) {
      return isAuthenticated();
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // DEPOSITS COLLECTION (User Submissions & SaaS Admin Review)
    match /deposits/{depositId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // WITHDRAWAL REQUESTS
    match /withdrawal_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // CAMPAIGNS
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /campaign_days/{dayId} {
      allow read, write: if true;
    }
    
    match /campaign_tasks/{taskId} {
      allow read, write: if true;
    }

    match /organizations/{orgId} {
      allow read, write: if true;
    }
    
    match /organization_members/{memberId} {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /apps/{appId} {
      allow read, write: if true;
    }
    
    match /tester_applications/{appId} {
      allow read, write: if true;
    }
    
    match /tester_assignments/{assignId} {
      allow read, write: if true;
    }
    
    match /test_sessions/{sessionId} {
      allow read, write: if true;
    }
    
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    
    // FEEDBACK & REVIEWS
    match /bugs/{bugId} {
      allow read, write: if true;
    }
    match /bug_comments/{commentId} {
      allow read, write: if true;
    }
    match /bug_history/{historyId} {
      allow read, write: if true;
    }
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }
    match /tester_reviews/{reviewId} {
      allow read, write: if true;
    }
    match /customer_reviews/{reviewId} {
      allow read, write: if true;
    }
    match /tester_quality_scores/{scoreId} {
      allow read, write: if true;
    }
    match /badges/{badgeId} {
      allow read, write: if true;
    }
    match /tester_badges/{tbId} {
      allow read, write: if true;
    }

    // FINANCIAL & WALLETS
    match /wallets/{walletId} {
      allow read, write: if true;
    }
    match /wallet_ledger/{ledgerId} {
      allow read, write: if true;
    }
    match /rewards/{rewardId} {
      allow read, write: if true;
    }
    match /reward_config_versions/{versionId} {
      allow read, write: if true;
    }

    // PAYMENTS & KYC
    match /payment_methods/{methodId} {
      allow read, write: if true;
    }
    match /identity_verifications/{kycId} {
      allow read, write: if true;
    }
    match /payment_webhook_events/{eventId} {
      allow read, write: if true;
    }
    match /payment_provider_configs/{configId} {
      allow read, write: if true;
    }

    // ADMIN CONTROL & RISK
    match /user_restrictions/{restrictionId} {
      allow read, write: if true;
    }
    match /disputes/{disputeId} {
      allow read, write: if true;
    }
    match /risk_events/{eventId} {
      allow read, write: if true;
    }
    match /admin_notes/{noteId} {
      allow read, write: if true;
    }
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /application_errors/{errorId} {
      allow read, write: if true;
    }
    
    match /report_jobs/{jobId} {
      allow read, write: if true;
    }

    // AI & PLAY STORE
    match /ai_requests/{requestId} {
      allow read, write: if true;
    }
    match /ai_usage/{usageId} {
      allow read, write: if true;
    }
    match /play_store_checklists/{appId} {
      allow read, write: if true;
    }
    match /release_checklists/{releaseId} {
      allow read, write: if true;
    }

    // INCIDENTS & FEATURE FLAGS
    match /incidents/{incidentId} {
      allow read, write: if true;
    }
    match /incident_events/{eventId} {
      allow read, write: if true;
    }
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if true;
    }

    // PLATFORM SETTINGS & PRICING
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
